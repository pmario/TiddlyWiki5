title: $:/core/ui/ControlPanel/Settings/TagSorting
tags: $:/tags/ControlPanel/Settings
caption: {{$:/language/ControlPanel/Settings/TagSorting/Caption}}

\define lingo-base() $:/language/ControlPanel/Settings/TagSorting/

<!-- A filter operand cannot contain square brackets, so the preset is held in a variable and compared with match<var> -->
\procedure sorted-preset() [sort[]]

<!-- The effective mode: what is stored, or failing that what the filter itself implies, so editing the filter by hand still selects the right radio -->
\function tf.tagSortMode(mode, filter)
[<mode>get[text]]
:else[<filter>get[text]match<sorted-preset>then[alphabetical]]
:else[<filter>get[text]!match[]then[custom]]
:else[[unsorted]]
\end

<!-- "custom" cannot be a value of the filter tiddler itself, or choosing it would overwrite the filter being written, so the radios have a mode tiddler of their own. The templates read only the filter tiddlers, never the mode -->
\procedure tag-sort-radios(mode, filter)
<$let effective={{{ [function[tf.tagSortMode],<mode>,<filter>] }}}>

<$radio tiddler=<<mode>> value="unsorted" default=<<effective>> actions="""<$action-setfield $tiddler=<<filter>> text=""/>""">
<span class="tc-tiny-gap-left"><<lingo Unsorted>></span>
</$radio><br>
<$radio tiddler=<<mode>> value="alphabetical" default=<<effective>> actions="""<$action-setfield $tiddler=<<filter>> text="[sort[]]"/>""">
<span class="tc-tiny-gap-left"><<lingo Alphabetical>></span>
</$radio><br>
<$radio tiddler=<<mode>> value="custom" default=<<effective>>>
<span class="tc-tiny-gap-left"><<lingo Custom/Radio>></span>
</$radio>
</$let>
\end

\procedure tag-sort-input(mode, filter)
<$let effective={{{ [function[tf.tagSortMode],<mode>,<filter>] }}}>
<$edit-text tiddler=<<filter>> tag="input" class="tc-edit-texteditor" disabled={{{ [<effective>match[custom]then[no]] :else[[yes]] }}}/>
</$let>
\end

<$link to="$:/config/Tags/SortFilter" class="tc-control-panel-item">
<<lingo TiddlerTags/Hint>>
</$link>

><<tag-sort-radios "$:/config/Tags/SortMode" "$:/config/Tags/SortFilter">>

<$link to="$:/config/Tags/GlobalSortFilter" class="tc-control-panel-item">
<<lingo GlobalTags/Hint>>
</$link>

><<tag-sort-radios "$:/config/Tags/GlobalSortMode" "$:/config/Tags/GlobalSortFilter">>

!! <<lingo Custom/Heading>>

<<<

<%if [function[tf.tagSortMode],[$:/config/Tags/SortMode],[$:/config/Tags/SortFilter]match[custom]] :else[function[tf.tagSortMode],[$:/config/Tags/GlobalSortMode],[$:/config/Tags/GlobalSortFilter]match[custom]] %>
<div class="tc-message-box">

<<lingo Custom/Warning>></div>

<%endif%>

<<lingo Custom/Hint>>

|<<lingo TiddlerTags/Caption>> |<<tag-sort-input "$:/config/Tags/SortMode" "$:/config/Tags/SortFilter">> |
|<<lingo GlobalTags/Caption>> |<<tag-sort-input "$:/config/Tags/GlobalSortMode" "$:/config/Tags/GlobalSortFilter">> |

<<<